{
  "name": "tooltips-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "cross-env VITE_DATA_URL=/local-data/ vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local": "cross-env TEST_DATA=local vitest run",
    "fetch-fixtures": "node scripts/fetch-fixtures.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.16",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.48.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.47.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite": "^5.2.0",
    "vitest": "^3.2.4"
  }
